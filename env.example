# ===========================================================================
# Este proyecto NO necesita API keys ni CAPTCHA.
# Copia este archivo como ".env" solo si quieres cambiar estos valores.
# Las rutas, la hoja y el mapeo se guardan en config.json desde la interfaz.
# ===========================================================================

# Intentos por persona si la consulta falla.
MAX_ATTEMPTS=2

# Driver: auto (undetected-chromedriver con respaldo a Selenium) | uc | selenium
DRIVER_BACKEND=auto
